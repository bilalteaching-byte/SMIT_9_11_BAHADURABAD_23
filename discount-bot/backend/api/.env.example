# Server
PORT=3000

# Database
MONGODBURI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Resend email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Discount Bot <onboarding@resend.dev>"

# OTP signing secret (use a long, random value)
OTP_SECRET=replace_with_a_long_random_secret

# Bearer token signing secret (use a different long, random value)
AUTH_TOKEN_SECRET=replace_with_another_long_random_secret
